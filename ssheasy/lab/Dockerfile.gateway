FROM golang:1.26.8-bookworm AS wasm
WORKDIR /src
COPY web/ ./
RUN GOOS=js GOARCH=wasm go build -o /main.wasm .
FROM node:22-bookworm-slim
WORKDIR /app
COPY lab/gateway/package*.json ./
RUN npm ci --omit=dev
COPY lab/gateway/*.mjs ./
COPY lab/public/ public/
COPY web/html/node_modules/@xterm/xterm/lib/xterm.js public/xterm.js
COPY web/html/node_modules/@xterm/xterm/css/xterm.css public/xterm.css
COPY web/html/node_modules/@xterm/addon-fit/lib/addon-fit.js public/addon-fit.js
COPY --from=wasm /main.wasm public/main.wasm
COPY --from=wasm /usr/local/go/lib/wasm/wasm_exec.js public/wasm_exec.js
USER node
EXPOSE 8080
CMD ["node","server.mjs"]
