FROM golang:1.26.8-bookworm AS go
FROM node:22-bookworm-slim AS node
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends openssh-server bash git python3 python3-pip python3-venv curl ca-certificates unzip jq build-essential pkg-config ripgrep tmux less nano vim-tiny procps openssl && rm -rf /var/lib/apt/lists/*
COPY --from=go /usr/local/go /usr/local/go
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
RUN curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/aws.zip && unzip -q /tmp/aws.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/aws.zip
RUN apt-get -o Acquire::Retries=5 update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends gh sudo && rm -rf /var/lib/apt/lists/*
RUN cd /tmp && curl --retry 3 -fsSLO https://releases.hashicorp.com/terraform/1.16.1/terraform_1.16.1_linux_amd64.zip && curl --retry 3 -fsSLO https://releases.hashicorp.com/terraform/1.16.1/terraform_1.16.1_SHA256SUMS && grep ' terraform_1.16.1_linux_amd64.zip$' terraform_1.16.1_SHA256SUMS | sha256sum -c - && unzip -q terraform_1.16.1_linux_amd64.zip terraform -d /usr/local/bin && rm terraform_1.16.1_linux_amd64.zip terraform_1.16.1_SHA256SUMS
RUN useradd -m -s /bin/bash participant && passwd -d participant && mkdir -p /run/sshd /workspace && chown participant:participant /workspace
COPY lab/workspace/sudoers /etc/sudoers.d/participant
RUN chmod 0440 /etc/sudoers.d/participant && visudo -cf /etc/sudoers.d/participant
RUN rm -f /etc/ssh/ssh_host_ed25519_key /etc/ssh/ssh_host_ed25519_key.pub /etc/ssh/ssh_host_rsa_key /etc/ssh/ssh_host_rsa_key.pub /etc/ssh/ssh_host_ecdsa_key /etc/ssh/ssh_host_ecdsa_key.pub
ENV PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin TERM=xterm-256color COLORTERM=truecolor
ENV GOCACHE=/home/participant/.cache/go-build GOMODCACHE=/home/participant/go/pkg/mod
# Keep source and caches in the image filesystem, not disposable BuildKit cache
# mounts. Use the same user, paths and flags as the provisioning build.
ARG YOLOMANCER_REVISION
USER participant
WORKDIR /workspace
RUN test -n "$YOLOMANCER_REVISION" && git clone --depth 1 https://github.com/dennisvink/yolomancer.git /workspace && test "$(git rev-parse HEAD)" = "$YOLOMANCER_REVISION" && go mod download && GOMAXPROCS=2 go build -p 2 -o /workspace/yolomancer . && chmod 755 /workspace/yolomancer
USER root
COPY lab/workspace/sshd_config /etc/ssh/sshd_config
COPY lab/workspace/bootstrap.py /usr/local/bin/bootstrap.py
COPY lab/workspace/bashrc /home/participant/.bashrc
EXPOSE 22
WORKDIR /workspace
CMD ["python3","/usr/local/bin/bootstrap.py"]
